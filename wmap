#!/bin/sh

NAMESPACE="wmap@wmap.dev"
VERSION="0.1.0"

main() {
	local profile=$1

	allowed_signers "${profile}"
}


# Return true if we have "tool" installed
we_have() {
	local tool=$1

	command -v "${tool}" >/dev/null 2>&1
}

# Return true if platform is "platform"
platform_is() {
	local platform=$1

	uname | grep "${platform}" >/dev/null 2>&1
}

# Return the contents of the public keys associated with "profile".
fetch_keys() {
	local profile=$1

	local pubkeys_url="${profile}.keys"

	if we_have curl; then
		curl --silent "${pubkeys_url}"
	elif we_have wget; then
		wget -qO- "${pubkeys_url}"
	elif platform_is OpenBSD; then
		# OpenBSD ships with an ftp tool that doubles as an https
		# client.
		ftp -o - "${pubkeys_url}"
	else
		echo "Error: No appropriate http client could be found" >&2
		exit 1
	fi
}

# Return an ALLOWED SIGNERS file for "profile".
allowed_signers() {
	local profile=$1

	fetch_keys "${profile}" | while IFS= read -r line; do
		echo "${profile} namespaces=\"${NAMESPACE}\" ${line}"
	done
}

# Check if the script is being executed or sourced. We only want to invoke
# `main` if the script is being executed. This is akin to Python's 
# 	if __name__ == "__main__":
# pattern.
(return 0 2>/dev/null) && sourced=1 || sourced=0
if [ "${sourced}" -eq 0 ]; then
	main $*
fi
